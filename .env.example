# Any OpenAI-compatible endpoint. Copy to .env and fill in; .env is gitignored.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-model-name

# Optional: a name for the running version, shown by suwageval (e.g. the git SHA).
# SUWAGEVAL_LABEL=

# Optional: the system prompt, "default" (unset too) or "concise". `just sweep` sets it per variant.
# SUWEXAG_PROMPT=
